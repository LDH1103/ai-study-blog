---
import '../styles/global.css';
import { toSitePath } from '../lib/site-path';

interface Props {
  title: string;
  description: string;
  activePath: '/' | '/notes' | '/about';
}

const { title, description, activePath } = Astro.props;
const siteName = 'AI Lab Log';
const baseUrl = import.meta.env.BASE_URL;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const navigation = [
  { href: '/', label: '홈' },
  { href: '/notes', label: '글' },
  { href: '/about', label: '소개' },
] as const;

---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="site-frame masthead">
        <a class="site-name" href={toSitePath(baseUrl, '/')} aria-label={`${siteName} 홈`}>
          <span aria-hidden="true">//</span>
          {siteName}
        </a>
        <p class="masthead-status" aria-label="기록 상태: 운영 중">LOG / ACTIVE</p>
        <nav aria-label="주요 메뉴">
          <ul class="site-nav">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={toSitePath(baseUrl, item.href === '/' ? item.href : `${item.href}/`)}
                    aria-current={item.href === activePath ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-main site-frame" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-frame footer-content">
        <p>AI 스터디의 배움과 실험을 기록합니다.</p>
        <p><a href={toSitePath(baseUrl, '/')}>AI Lab Log</a></p>
      </div>
    </footer>
  </body>
</html>
