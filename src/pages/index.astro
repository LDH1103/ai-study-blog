---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatKoreanDate } from '../lib/format-date';
import { toSitePath } from '../lib/site-path';

const siteBase = import.meta.env.BASE_URL;

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
;
const latestNotes = notes.slice(0, 5);
---

<BaseLayout
  title="AI Lab Log"
  description="AI를 공부하고 실험하며 검증한 기록을 쌓는 개인 기술 블로그입니다."
  activePath="/"
>
  <div class="content-column home-content">
    <header class="home-hero">
      <div class="home-hero__intro">
        <h1>AI를 공부하며 기록합니다.</h1>
        <p>읽고 이해한 내용과 직접 확인한 결과를 차분히 남깁니다.</p>
      </div>
    </header>

    <section class="home-section latest-posts" aria-labelledby="latest-notes-heading">
      <div class="section-heading">
        <h2 id="latest-notes-heading">최신 글</h2>
        <a href={toSitePath(siteBase, '/notes/')}>글 전체 보기<span class="visually-hidden">: 최신 글</span></a>
      </div>
      {
        latestNotes.length > 0 ? (
          <ol class="entry-list post-feed">
            {latestNotes.map((note) => (
              <li>
                <article>
                  <p class="entry-meta">
                    <time datetime={note.data.publishedAt.toISOString().slice(0, 10)}>
                      {formatKoreanDate(note.data.publishedAt)}
                    </time>
                  </p>
                  <h3><a href={toSitePath(siteBase, `/notes/${note.id}/`)}>{note.data.title}</a></h3>
                  <p>{note.data.description}</p>
                  {
                    note.data.tags.length > 0 && (
                      <ul class="tag-list" aria-label={`${note.data.title} 태그`}>
                        {note.data.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    )
                  }
                </article>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">첫 글을 정리하고 있습니다. 확인이 끝나는 대로 이곳에 기록합니다.</p>
        )
      }
    </section>
  </div>
</BaseLayout>
