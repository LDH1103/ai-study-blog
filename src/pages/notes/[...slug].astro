---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatKoreanDate } from '../../lib/format-date';
import { toSitePath } from '../../lib/site-path';

interface Props {
  entry: CollectionEntry<'notes'>;
}

const siteBase = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);

  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} activePath="/notes">
  <article class="content-column prose">
    <nav class="breadcrumb" aria-label="경로">
      <a href={toSitePath(siteBase, '/notes/')}>학습 노트</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{entry.data.title}</span>
    </nav>
    <header class="article-header">
      <p class="eyebrow">Learning note</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="entry-meta">
        <time datetime={entry.data.publishedAt.toISOString().slice(0, 10)}>
          {formatKoreanDate(entry.data.publishedAt)}
        </time>
      </p>
      {
        entry.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="태그">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </header>
    <Content />
  </article>
</BaseLayout>
