---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatKoreanDate } from '../../lib/format-date';
import { toSitePath } from '../../lib/site-path';

interface Props {
  entry: CollectionEntry<'notes'>;
}

const siteBase = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);

  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="content-column prose">
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      <p class="entry-meta">
        <time datetime={entry.data.publishedAt.toISOString().slice(0, 10)}>
          {formatKoreanDate(entry.data.publishedAt)}
        </time>
      </p>
      {
        entry.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="태그">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
      {
        entry.data.slidesHtml && (
          <p>
            <a href={toSitePath(siteBase, entry.data.slidesHtml)}>
              슬라이드 보기<span class="visually-hidden">: {entry.data.title}</span>
            </a>
          </p>
        )
      }
    </header>
    <Content />
  </article>
</BaseLayout>
