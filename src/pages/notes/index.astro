---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatKoreanDate } from '../../lib/format-date';
import { toSitePath } from '../../lib/site-path';

const siteBase = import.meta.env.BASE_URL;
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
  title="글"
  description="AI 스터디에서 읽고 실험하며 남긴 학습 기록입니다."
  activePath="/notes"
>
  <div class="content-column">
    <header class="page-heading">
      <p class="eyebrow">Post archive</p>
      <h1>글</h1>
      <p>이해한 내용을 내 언어로 다시 쓰고, 다음 실습의 출발점으로 남깁니다.</p>
    </header>

    {
      notes.length > 0 ? (
        <ol class="entry-list">
          {notes.map((note) => (
            <li>
              <article>
                <p class="entry-meta">
                  <time datetime={note.data.publishedAt.toISOString().slice(0, 10)}>
                    {formatKoreanDate(note.data.publishedAt)}
                  </time>
                </p>
                <h2><a href={toSitePath(siteBase, `/notes/${note.id}/`)}>{note.data.title}</a></h2>
                <p>{note.data.description}</p>
                {
                  note.data.tags.length > 0 && (
                    <ul class="tag-list" aria-label={`${note.data.title} 태그`}>
                      {note.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )
                }
                <p><a href={toSitePath(siteBase, `/notes/${note.id}/`)}>글 읽기<span class="visually-hidden">: {note.data.title}</span></a></p>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">아직 공개된 글이 없습니다. 첫 기록을 다듬는 중입니다.</p>
      )
    }
  </div>
</BaseLayout>
