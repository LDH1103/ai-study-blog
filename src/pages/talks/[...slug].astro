---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatKoreanDate } from '../../lib/format-date';
import { toSitePath } from '../../lib/site-path';

interface Props {
  entry: CollectionEntry<'talks'>;
}

const siteBase = import.meta.env.BASE_URL;
const toResourcePath = (path: string) =>
  path.startsWith('http://') || path.startsWith('https://') ? path : toSitePath(siteBase, path);

export async function getStaticPaths() {
  const talks = await getCollection('talks', ({ data }) => !data.draft);

  return talks.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const resources = [
  entry.data.slidesHtml && { href: toResourcePath(entry.data.slidesHtml), label: '슬라이드 열기' },
  entry.data.slidesPdf && { href: toResourcePath(entry.data.slidesPdf), label: 'PDF 내려받기' },
].filter((resource): resource is { href: string; label: string } => Boolean(resource));
---

<BaseLayout title={entry.data.title} description={entry.data.description} activePath="/talks">
  <article class="content-column prose">
    <nav class="breadcrumb" aria-label="경로">
      <a href={toSitePath(siteBase, '/talks/')}>발표</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{entry.data.title}</span>
    </nav>
    <header class="article-header">
      <p class="eyebrow">Study talk</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="entry-meta">
        <time datetime={entry.data.presentedAt.toISOString().slice(0, 10)}>
          {formatKoreanDate(entry.data.presentedAt)}
        </time>
      </p>
      {
        entry.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="태그">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </header>
    {
      resources.length > 0 && (
        <section class="resource-links" aria-labelledby="presentation-materials-heading">
          <h2 id="presentation-materials-heading">발표 자료</h2>
          <ul>
            {resources.map((resource) => <li><a href={resource.href}>{resource.label}<span class="visually-hidden">: {entry.data.title}</span></a></li>)}
          </ul>
        </section>
      )
    }
    <Content />
  </article>
</BaseLayout>
